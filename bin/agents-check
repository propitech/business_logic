#!/usr/bin/env ruby
# frozen_string_literal: true

# Offline AGENTS.md integrity check.
#
# 1. Verifies each cached layer file's SHA256 matches agents.lock.json.
# 2. Re-renders AGENTS.md into a temp file and diffs against the committed copy.
# 3. Delta-slug collision: fails if deltas.md defines a {#slug} already in a
#    baseline layer (prevents a project rule silently shadowing a shared rule).
#
# No network required. Run by CI. Exits non-zero on any failure.

require 'digest'
require 'json'
require 'set'
require 'shellwords'
require 'tmpdir'

ROOT = File.expand_path('..', __dir__)
AGENTS_DIR = File.join(ROOT, '.config/propitech/agents')
LOCK_FILE = File.join(AGENTS_DIR, 'agents.lock.json')
AGENTS_MD = File.join(ROOT, 'AGENTS.md')
RENDER_BIN = File.join(ROOT, 'bin', 'agents-render')

unless File.exist?(LOCK_FILE)
  warn "agents-check: missing #{LOCK_FILE.delete_prefix("#{ROOT}/")}"
  exit 1
end

lock = JSON.parse(File.read(LOCK_FILE))
problems = []

# 1. Hash verification — each cached layer must match the pinned hash
lock.fetch('layerHashes').each do |layer, expected|
  path = File.join(AGENTS_DIR, "#{layer}.md")
  unless File.exist?(path)
    problems << "#{layer}.md: cached layer missing"
    next
  end

  actual = Digest::SHA256.hexdigest(File.read(path))
  next if actual == expected

  problems << "#{layer}.md: hash mismatch (cache edited in place? expected #{expected[0, 12]}…)"
end

unless problems.empty?
  warn 'agents-check: baseline cache integrity failure:'
  problems.each { |p| warn "  #{p}" }
  warn ''
  warn 'Re-run the fosa template to restore the pinned cache:'
  warn '  bin/rails app:template LOCATION=~/Devel/Propitech/fosa/template.rb'
  exit 1
end

# 2. Render check — re-render to temp and diff against the committed AGENTS.md
Dir.mktmpdir do |tmp|
  rendered = File.join(tmp, 'AGENTS.md')
  result = system(RbConfig.ruby, RENDER_BIN, '--output', rendered)

  unless result
    warn 'agents-check: agents-render failed'
    exit 1
  end

  unless File.exist?(AGENTS_MD)
    warn 'agents-check: AGENTS.md is missing — run `bin/agents-render`'
    exit 1
  end

  diff = `diff -u #{AGENTS_MD.shellescape} #{rendered.shellescape} 2>&1`
  unless diff.empty?
    warn 'agents-check: AGENTS.md is stale — run `bin/agents-render` to regenerate:'
    warn diff
    exit 1
  end
end

# 3. Delta-slug collision — deltas.md must not restate a baseline slug
deltas_file = File.join(AGENTS_DIR, 'deltas.md')
if File.exist?(deltas_file)
  baseline_slugs = lock['layers'].flat_map do |layer|
    path = File.join(AGENTS_DIR, "#{layer}.md")
    File.exist?(path) ? File.read(path).scan(/\{#([a-z][a-z0-9-]*)\}/).flatten : []
  end.to_set

  delta_slugs = File.read(deltas_file).scan(/\{#([a-z][a-z0-9-]*)\}/).flatten
  collisions = delta_slugs.select { |s| baseline_slugs.include?(s) }

  unless collisions.empty?
    warn 'agents-check: delta slug collision(s) — these slugs already exist in the baseline:'
    collisions.each { |s| warn "  {##{s}}" }
    warn ''
    warn 'Either rename the delta slug or remove the rule (it is already in the baseline).'
    exit 1
  end
end

puts "agents-check: OK (baseline v#{lock['baselineVersion']}, #{lock['layers'].join(' + ')})"
